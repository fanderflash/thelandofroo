      ],
      "sourceImages": [
        "https://raw.githubusercontent.com/fanderflash/thelandofroo/693211b82d6459da9f9ad393dfdc559060dfe9ba/assets/social/2026-11-04/17-cloak-before-source.jpg",
        "https://raw.githubusercontent.com/fanderflash/thelandofroo/693211b82d6459da9f9ad393dfdc559060dfe9ba/assets/social/2026-11-04/17-cloak-after-source.jpg"
      ],
      "platforms": {
